<% layout("/layouts/boilerplate") %>
<div class="row mt-3">
  <div class="col-8 offset-2">
    <h3>Create a new listing</h3>
    <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
      <div class="mb-2">
        <lable for="title" class="form-label">Title</lable>
        <input
          name="listing[title]"
          placeholder="Add title"
          type="text"
          class="form-control"
          required
        />
        <div class="valid-feedback">Title looks good</div>
      </div>

      <div class="mb-2">
        <lable for="description" class="form-label">Description</lable>
        <textarea
          name="listing[description]"
          placeholder=""
          class="form-control"
          required
        ></textarea>
        <div class="invalid-feedback">Please enter a short description</div>
      </div>

      <div class="mb-2">
        <lable for="image" class="form-label">Upload Listing Image</lable>
        <input
          name="listing[image][url]"
          type="file"
          class="form-control"
        />
      </div>

      <div class="row">
        <div class="mb-2 col-md-4">
          <lable for="price" class="form-label">Price (in &#8377;)</lable>
          <input
            name="listing[price]"
            placeholder="1300"
            
            class="form-control"
            required
          />
          <div class="invalid-feedback">Please enter a valid price</div>
        </div>

        <div class="mb-2 col-md-8">
          <lable for="country" class="form-label">Country</lable>
          <input
            name="listing[country]"
            placeholder="India"
            type="text"
            class="form-control"
            required
          />
          <div class="invalid-feedback">Country name should be valid</div>
        </div>
      </div>

      <div class="mb-2">
        <lable for="location" class="form-label">Location</lable>
        <input
          name="listing[location]"
          placeholder="New Delhi"
          type="text"
          class="form-control"
          required
        />
        <div class="invalid-feedback">Location should be valid</div>
      </div>

      <br />
      <button class="btn btn-dark add-btn">Add</button>
    </form>
    <br>
  </div>
</div>
